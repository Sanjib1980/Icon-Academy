# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Supabase Central Database & Storage Configuration (Production & Vercel)
# -----------------------------------------------------------------------------
# 1. Obtain your credentials from Supabase:
#    - Go to https://supabase.com/dashboard -> Select your project -> Project Settings -> API.
#    - Copy "Project URL" and the "anon public" API key.
#
# 2. How to set these in the Vercel Project Dashboard:
#    - Go to https://vercel.com/dashboard and select your deployed project.
#    - Navigate to: Settings -> Environment Variables.
#    - Add the following two variables:
#        Key:   VITE_SUPABASE_URL
#        Value: https://your-project-id.supabase.co
#        Target: Production, Preview, Development (select all three)
#
#        Key:   VITE_SUPABASE_ANON_KEY
#        Value: your-supabase-anon-public-key
#        Target: Production, Preview, Development (select all three)
#    - Click "Save" for each variable.
#    - Note: After saving, trigger a Redeploy (Deployments -> ... menu -> Redeploy)
#      so Vite embeds the VITE_* environment variables into the production build.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"


